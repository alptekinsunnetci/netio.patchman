# netio.patchman sunucu yapılandırması
# Bu dosyayı .env adıyla kopyalayın ve değerleri ortamınıza göre düzenleyin.
# Dosya UTF-8 olarak kaydedilmelidir.
#
# (*) ile işaretli ayarlar panelde Sistem Ayarları -> Sunucu yapılandırması
# sayfasından da değiştirilebilir. Buradaki değer yalnızca ilk değerdir;
# panelde kaydedilen değer bunun yerine geçer ve yeniden başlatma gerektirmez.

# Docker'ın sunucuda yayınladığı port (varsayılan 8080).
# Ters vekil (nginx, Caddy, Plesk) aynı makinedeyse yalnızca yerel arabirimde
# yayınlayın; böylece panel dışarıya şifresiz HTTP ile açılmaz:
# PATCHMAN_PUBLISH_PORT=127.0.0.1:8899
# Doğrudan erişim için yalnızca port numarası yazın:
# PATCHMAN_PUBLISH_PORT=8899
#
# Not: PATCHMAN_HTTP_ADDR yalnızca Docker dışı kurulumlarda kullanılır;
# Docker Compose'da konteyner her zaman 8080'i dinler.

# (*) Yönetim paneline ve ajanların bağlandığı dış adres.
# E-posta bağlantılarında ve ajan kurulum komutunda kullanılır.
# https ile başlıyorsa oturum çerezleri yalnızca HTTPS üzerinden gönderilir.
PATCHMAN_BASE_URL=https://patchman.your-domain

# (*) Sunucu bir ters vekil (nginx, Caddy, HAProxy) arkasındaysa true yapın;
# istemci IP adresi X-Forwarded-For başlığından okunur.
PATCHMAN_TRUST_PROXY=false

# Sunucunun TLS'i kendisinin sonlandırması için (ters vekil kullanmıyorsanız):
# PATCHMAN_TLS_CERT_FILE=/etc/netio-patchman/tls.crt
# PATCHMAN_TLS_KEY_FILE=/etc/netio-patchman/tls.key

# Veritabanı dizini (Docker imajında /data)
# PATCHMAN_DATA_DIR=/var/lib/netio-patchman

# Arayüz dili ve (*) görüntüleme saat dilimi.
# Zaman bilgileri veritabanında her zaman UTC olarak saklanır.
PATCHMAN_LOCALE=tr-TR
PATCHMAN_TIMEZONE=Europe/Istanbul

# Günlük kayıtları: (*) seviye (debug, info, warn, error) ve biçim (json, text)
PATCHMAN_LOG_LEVEL=info
PATCHMAN_LOG_FORMAT=json

# (*) Güvenlik açığı veri kaynakları. İnternet erişimi olmayan ortamlarda
# OSV için iç ağdaki bir yansı adresi verilebilir; KEV için "off" yazılabilir.
# PATCHMAN_OSV_URL=https://api.osv.dev
# PATCHMAN_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# (*) Yeni sürüm denetimi: panel, yöneticilere yeni bir netio.patchman sürümü
# yayımlandığını bildirir. Varsayılan adres depodaki VERSION dosyasıdır.
# İnternet erişimi olmayan ortamlarda "off" yazın.
# PATCHMAN_UPDATE_CHECK_URL=https://raw.githubusercontent.com/alptekinsunnetci/netio.patchman/main/VERSION

# (*) E-posta bildirimleri (SMTP)
# SMTP sunucusu boş bırakılırsa e-posta bildirimleri devre dışı kalır.
# 465 numaralı port doğrudan TLS, diğer portlar STARTTLS kullanır.
PATCHMAN_SMTP_HOST=
PATCHMAN_SMTP_PORT=587
PATCHMAN_SMTP_USERNAME=
PATCHMAN_SMTP_PASSWORD=
# Gönderen: "netio.patchman <patchman@your-domain>"
# Gönderen adresinin varsayılan bir değeri yoktur; kendi alan adınızı yazın.
PATCHMAN_SMTP_FROM_NAME=netio.patchman
PATCHMAN_SMTP_FROM_ADDRESS=patchman@your-domain
