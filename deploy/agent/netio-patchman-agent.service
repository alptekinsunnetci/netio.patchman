[Unit]
Description=netio.patchman ajanı - Merkezi Linux Güvenlik Açığı ve Güncelleme Yönetimi
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/netio-patchman-agent -config /etc/netio-patchman/agent.env
Restart=always
RestartSec=15s
SyslogIdentifier=netio-patchman-agent
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
StateDirectory=netio-patchman
StateDirectoryMode=0700

# The agent reads package manager databases and applies updates on request,
# so it runs as root. Filesystem sandboxing (ProtectSystem, ProtectHome) is
# intentionally not used: package maintainer scripts run as children of the
# agent and may write anywhere a normal upgrade does.
PrivateTmp=yes
# Package upgrades may restart services; do not kill them with the agent.
KillMode=process
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
